# AceOS Environment Variables
# Copy to .env.local and fill in all values before running locally.
# Never commit .env.local to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to client

# ─── AI Providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                              # GPT-4o, GPT-4o-mini routes
GROQ_API_KEY=gsk_...                               # Groq Llama routes

# ─── Modal.com STEM Sandbox (TS2-01) ─────────────────────────────────────────
MODAL_SANDBOX_URL=https://aceos-stem-validator--validate.modal.run
MODAL_API_KEY=your-modal-webhook-secret            # auth for Modal webhook
MODAL_TOKEN_ID=ak-...                              # for CLI deployment: modal deploy
MODAL_TOKEN_SECRET=as-...                          # for CLI deployment: modal deploy
