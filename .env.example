# ============================================================
# AceOS — Environment Variables Reference
# Copy this to .env.local for local development (never commit .env.local)
# All variables prefixed NEXT_PUBLIC_ are safe to expose in the browser.
# All others are server-only secrets.
# ============================================================

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://aceos-ai.vercel.app

# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://olybgkhggqnmrfcjjojy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NEVER expose to browser

# ── AI Providers ───────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-key-here
GROQ_API_KEY=your-groq-key-here

# ── Modal STEM Sandbox ────────────────────────────────────────────────
MODAL_SANDBOX_URL=your-modal-url-here
MODAL_API_KEY=your-modal-key-here

# ── Email (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-key-here
EMAIL_FROM=noreply@aceos-ai.vercel.app
EMAIL_FROM_NAME=AceOS

# ── Analytics (PostHog) — optional in Phase 1 ─────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Vercel CI (GitHub Actions only — never set these in Vercel dashboard) ──────
# VERCEL_TOKEN=          ← GitHub secret: VERCEL_TOKEN
# VERCEL_ORG_ID=         ← GitHub secret: VERCEL_ORG_ID
# VERCEL_PROJECT_ID=     ← GitHub secret: VERCEL_PROJECT_ID
